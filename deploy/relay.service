[Unit]
Description=Relay AHP Fleet Console
After=network.target ahpd.service
Wants=ahpd.service

[Service]
Type=simple
WorkingDirectory=%h/work/Relay
ExecStart=/usr/bin/node %h/work/Relay/src/serve.mjs
Environment=PORT=4200
Environment=HOST=0.0.0.0
Environment=RELAY_DEMO_BOOTSTRAP_FILE=%h/work/Relay/.local/demo/bootstrap.json
Environment=RELAY_DEMO_TOKEN_FILE=%h/work/Relay/.local/demo/connection-token
Restart=always
RestartSec=5
NoNewPrivileges=true
KillMode=mixed
TimeoutStopSec=20

[Install]
WantedBy=default.target
